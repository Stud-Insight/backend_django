from celery import shared_task
from django.core.mail import send_mail
from django.conf import settings
import logging
from datetime import timedelta
from django.utils import timezone

logger = logging.getLogger(__name__)

@shared_task
def send_email_notification_task(user_email, subject, message):
    """
    Tâche Celery pour envoyer des emails en arrière-plan.
    """
    try:
        send_mail(
            subject=subject,
            message=message,
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[user_email],
            fail_silently=False,
        )
        # Log de succès (Critère 7.4.4)
        logger.info(f"Email envoyé avec succès à {user_email}")
        return f"Email sent to {user_email}"
    except Exception as e:
        logger.error(f"Échec de l'envoi d'email à {user_email}: {str(e)}")
        raise e

@shared_task
def check_deadlines_and_notify():
    tomorrow = timezone.now() + timedelta(days=1)
    upcoming_tasks = Task.objects.filter(deadline__date=tomorrow.date())

    for task in upcoming_tasks:
        send_email_notification_task.delay(
            task.assigned_to.email,
            "Rappel : Deadline dans 24h",
            f"La tâche {task.title} arrive à échéance demain."
        )